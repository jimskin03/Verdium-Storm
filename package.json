{
  "name": "verdium-storm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "server": "node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:client && npm run test:server",
    "test:client": "vitest run tests",
    "test:server": "npm --prefix server test",
    "shoot": "node tools/shoot.mjs",
    "agent:build": "vite build --mode agent --outDir dist-agent",
    "agent:smoke": "node tools/agent-play.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.172.0",
    "typescript": "5.7.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "three": "0.172.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
